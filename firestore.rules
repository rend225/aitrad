rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin - improved with null checks
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection - Allow user creation and self-management
    match /users/{userId} {
      // Allow users to create their own document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow users to read and update their own data
      allow read, update: if isOwner(userId);
      // Allow admins to read all users (but handle case where admin doc doesn't exist yet)
      allow read: if isAuthenticated(); // More permissive for initial setup
      // Allow admins to update any user (for plan management, etc.)
      allow update: if isAdmin() || isOwner(userId);
      // Prevent deletion except by admins
      allow delete: if isAdmin();
    }
    
    // Recommendations collection - User data with admin access
    match /recommendations/{userId} {
      allow read, write: if isOwner(userId);
      allow read, write: if isAdmin();
      
      match /{document=**} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }
    }
    
    // Plans are publicly readable, admin writable
    match /plans/{document} {
      allow read: if true; // Public read access for pricing page
      allow write: if isAdmin();
    }
    
    // Schools - authenticated read, admin write
    match /schools/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Featured signals - public read, admin write
    match /featured_signals/{document} {
      allow read: if true; // Public read for homepage
      allow write: if isAdmin();
    }
    
    // Settings - public read for SEO, admin write
    match /settings/{document} {
      allow read: if true; // Public read for SEO settings
      allow write: if isAdmin();
    }
    
    // Admin-only access
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Chat system rules
    match /chats/{chatId} {
      // Users can create new chats where they are the owner
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      // Users can read/update/delete their own chats
      allow read, update, delete: if isAuthenticated() && 
                                   resource != null && 
                                   resource.data != null && 
                                   resource.data.userId != null && 
                                   request.auth.uid == resource.data.userId;
      // Admins can read/write all chats
      allow read, write: if isAdmin();
      
      // Chat messages
      match /messages/{messageId} {
        // Users can create/read/write messages in their own chats
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/chats/$(chatId)) &&
                      get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
        allow read, write: if isAuthenticated() && 
                           exists(/databases/$(database)/documents/chats/$(chatId)) &&
                           get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
        // Admins can read/write all messages
        allow read, write: if isAdmin();
      }
    }
    
    // Allow temporary anonymous access for debugging (remove in production)
    match /debug/{document} {
      allow read, write: if isAuthenticated();
    }

    // Temporary: More permissive rules for initial project setup
    // TODO: Remove these after initial setup is complete
    match /temp_setup/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
